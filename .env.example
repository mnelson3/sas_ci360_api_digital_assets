# SAS CI360 Environment Configuration
# Copy this file to .env and fill in your values.
#
# The test suite in tests/ makes live calls against a real SAS CI360
# tenant and requires these to be set as real environment variables
# (not just present in .env) to run.

SASCI360_HOST=extapigwservice-training.ci360.sas.com
SASCI360_SECRET_KEY=your-secret-key-here
SASCI360_TENANT_ID=your-tenant-id-here
